# 复制为 deploy/.env 后填入实际值。生产 JWT secret 用 `openssl rand -hex 32` 生成。
POSTGRES_DB=stellaris
POSTGRES_USER=stellaris
POSTGRES_PASSWORD=stellaris
USER_JWT_SECRET=please-change-this-in-prod-32bytes-random
PLANET_JWT_SECRET=please-change-this-in-prod-also-32bytes
# 全局共用的唯一后台账号（登录用）
ADMIN_EMAIL=admin@stellaris.local
ADMIN_PASSWORD=please-change-this-password
